# Copy this file to `.env` for local development.
# `docker-compose.yml` provisions Postgres and Valkey matching these values.

DATABASE_URL="postgresql://pulsedesk:pulsedesk@localhost:5432/pulsedesk?schema=public"
REDIS_URL="redis://localhost:6379"
# Dev-only placeholder — never reuse this value outside local development.
WIDGET_JWT_SECRET="dev-only-widget-jwt-secret-change-me-please-32chars"
