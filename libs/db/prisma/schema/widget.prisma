// Minimal Customer/Conversation shape needed for the widget's dual-auth
// flow (POST /widget/conversations). See 02-add-dual-auth design.md.
// Message/ticket domain models are out of scope for this change.

model Customer {
  id            String         @id @default(uuid())
  // Anonymous client-generated identifier (e.g. persisted in the widget's
  // localStorage) used to recognize a returning visitor across page loads
  // without any credential.
  sessionId     String         @unique
  createdAt     DateTime       @default(now())
  conversations Conversation[]
  // Back-relation for 03-add-ticket-queue — see ticket.prisma.
  tickets       Ticket[]
}

model Conversation {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  // Bridges the widget's conversationId (JWT-scoped, see WidgetTokenPayload)
  // to the ticket/message domain — added by 05-add-realtime-hybrid. Null
  // until the customer's first `ws` `message:send`: `WidgetMessagingService`
  // lazily creates the ticket then (via `TicketsService.createTicket`, same
  // SLA/priority rules as an agent-created ticket) and links it here with an
  // atomic `updateMany({ where: { id, ticketId: null } })` guard — the same
  // race-safe pattern `TicketsService.claimTicket` already uses — so two
  // concurrent first-messages on the same conversation never create two
  // tickets. See openspec/changes/05-add-realtime-hybrid/tasks.md "Nota de
  // arquitectura: puente Conversation-Ticket".
  ticketId   String?  @unique
  ticket     Ticket?  @relation(fields: [ticketId], references: [id])
  createdAt  DateTime @default(now())

  @@index([customerId])
}
